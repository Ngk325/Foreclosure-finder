# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Firebase (client SDK config — safe to expose in a browser bundle)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Claude API (server-side / scripts only — never expose in the browser bundle)
CLAUDE_API_KEY=sk-ant-...

# Cloudflare Worker secrets (set via `wrangler secret put`, do not put real values here)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=
