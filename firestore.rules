rules_version = '2';

// Client (browser) access is read-only for the dashboard. All writes
// (scraping, analysis, outreach logging) go through the Cloudflare Worker,
// which authenticates as a service account via the Firestore REST API and
// is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
